# Placeholder configuration. This export intentionally contains no live account or tenant ID.
# Leave automatic release disabled until the target tenant and read-only results are verified.
YON_AUTO_RELEASE=0
YON_AUTO_LOGIN=1
# Required pin: replace with the SHA-256 of the verified tenant ID, exactly 64 lowercase hex characters.
# The placeholder is intentionally invalid; startup must refuse it.
YON_TENANT_HASH=REPLACE_WITH_VERIFIED_64_HEX_TENANT_SHA256
